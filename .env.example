# Firebase web config (Firebase console > Project settings > Your apps).
# These are inlined into the browser bundle at build time by design;
# Firestore Security Rules, not secrecy, protect the data.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Server-only. Never prefix with VITE_ (that would ship it to the browser).
OPENAI_API_KEY=your-openai-api-key
