# Firebase web config (Firebase console > Project settings > Your apps).
# These are inlined into the browser bundle at build time by design;
# Firestore Security Rules, not secrecy, protect the data.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Server-only. Never prefix with VITE_ (that would ship it to the browser).
OPENAI_API_KEY=your-openai-api-key

# Server-only Firebase Admin SDK (app/firebase/admin.server.ts).
# Local: leave the email and key empty to use Application Default Credentials
# (gcloud auth application-default login). Never prefix these with VITE_.
# Required. The deployment's project (app/firebase/projects.ts): devtalk-88046
# for production, devtalk-staging for Vercel Preview. Others are rejected.
FIREBASE_ADMIN_PROJECT_ID=devtalk-88046

# Deployments only: "production" or "staging". Must agree with Vercel's
# VERCEL_ENV and selects which project every Firebase variable must name.
# Leave unset locally.
DEVTALK_FIREBASE_ENV=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
